{
  "name": "todo-desktop",
  "version": "2.1.0",
  "description": "Knodo — 知识化待办（Knowledge + Todo）桌面应用（Electron + SQLite，本地存储 + AI 报告）",
  "main": "main/main.js",
  "author": "WorkBuddy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/kiverson/todo-task.git"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "gen-icon": "node scripts/gen-icon.js",
    "build:tools": "node scripts/build-tools.js",
    "test:db": "node scripts/smoke-db.js",
    "verify:desktop": "node scripts/verify-desktop-level.js",
    "dist": "node scripts/gen-icon.js && node scripts/build-tools.js && node scripts/build-win.js",
    "dist:portable": "node scripts/gen-icon.js && node scripts/build-win.js --target portable",
    "dist:installer": "node scripts/gen-icon.js && node scripts/build-win.js --target nsis",
    "release": "node scripts/release-gitee.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "@alenaksu/json-viewer": "^2.1.2",
    "7zip-bin": "^5.2.0",
    "diff": "^8.0.4",
    "easymde": "^2.21.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "flatpickr": "^4.6.13",
    "highlight.js": "^11.12.0",
    "jsonpath-plus": "^11.2.1",
    "markdown-it": "^14.3.3",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "2.6.6",
    "sql-formatter": "^15.9.0",
    "tom-select": "^2.4.3",
    "xml-formatter": "^3.7.0"
  },
  "build": {
    "appId": "com.workbuddy.todo-desktop",
    "productName": "Knodo",
    "copyright": "Copyright © 2026 WorkBuddy",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/prebuilds/darwin*",
      "!node_modules/better-sqlite3/prebuilds/linux*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Knodo",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-安装版.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
