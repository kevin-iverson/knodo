{
  "name": "todo-desktop",
  "version": "2.5.2",
  "description": "Knodo — 知识化待办（Knowledge + Todo）桌面应用（Electron + SQLite，本地存储 + AI 报告）",
  "main": "main/main.js",
  "author": {
    "name": "KevinOK"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/kiverson/todo-task.git"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "gen-icon": "node scripts/gen-icon.js",
    "test:db": "node scripts/smoke-db.js",
    "test:recur": "node scripts/smoke-recurrence.js",
    "verify:recur": "node scripts/verify-recurrence-ui.js",
    "verify:desktop": "node scripts/verify-desktop-level.js",
    "verify:identity": "node scripts/verify-notification-identity.js",
    "verify:wys": "node scripts/verify-wysiwyg.js",
    "verify:detail": "node scripts/verify-detail-notes.js",
    "verify:search": "node scripts/verify-search-modal.js",
    "verify:note": "node scripts/verify-note-desktop.js",
    "verify:dock": "node scripts/verify-dock.js",
    "dist": "node scripts/gen-icon.js && node scripts/build-vendor.js && node scripts/build-win.js",
    "dist:portable": "node scripts/gen-icon.js && node scripts/build-win.js --dir",
    "dist:installer": "node scripts/gen-icon.js && node scripts/build-win.js --target nsis --no-portable",
    "release": "node scripts/release-gitee.js",
    "release:github": "node scripts/release-github.js",
    "verify:appearance": "node scripts/verify-appearance.js",
    "smoke:theme-image": "node scripts/smoke-theme-image.js",
    "verify:calendar": "node scripts/verify-calendar-past-lock.js",
    "build:vendor": "node scripts/build-vendor.js",
    "verify:drawer": "node scripts/verify-detail-mask.js",
    "verify:dock-complete": "node scripts/verify-dock-complete.js",
    "verify:dock-side": "node scripts/verify-dock-side.js",
    "verify:add-inline": "node scripts/verify-add-inline.js",
    "verify:meeting-rename": "node scripts/verify-meeting-rename.js",
    "shots": "node scripts/shots.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "easymde": "^2.21.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "flatpickr": "^4.6.13",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.3",
    "mermaid": "^12.2.0",
    "tom-select": "^2.4.3",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "build": {
    "appId": "com.workbuddy.todo-desktop",
    "productName": "Knodo",
    "copyright": "Copyright © 2026 KevinOK",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/prebuilds/darwin*",
      "!node_modules/better-sqlite3/prebuilds/linux*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Knodo",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "${productName}-${version}-安装版.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
